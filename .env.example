# Copia este archivo como .env y rellénalo. El .env NUNCA se sube a GitHub.

# Web que quieres vigilar (solo http/https públicas)
MONITOR_URL=https://latidouptime.com

# Dónde recibir los avisos. Con el remitente de prueba de Resend solo puede ser
# el mismo email con el que creaste la cuenta de Resend.
ALERT_EMAIL=tu-email@ejemplo.com

# Clave de API de Resend (resend.com → API Keys → permiso "Sending access")
RESEND_API_KEY=

# Cada cuántos segundos comprobar (mínimo 60)
CHECK_INTERVAL_SECONDS=300

# Opcional, cuando verifiques tu dominio en Resend:
# ALERT_FROM=Latido <avisos@latidouptime.com>
